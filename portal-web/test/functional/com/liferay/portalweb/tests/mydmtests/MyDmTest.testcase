@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {
		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMDocument.addCP(
			dmDocumentFile = "Commerce_Blue.jpg",
			dmDocumentTitle = "Commerce_Blue.jpg");

		Navigator.gotoPage(pageName = "Home");

		MyBlogTest.clickToControlMenu();

		PageEditor.addWidgetViaKeyboard(
			categoryName = "Highlighted",
			widgetName = "Documents and Media");

		PortletEntry.publish();

		DMDocument.viewPG(dmDocumentTitle = "Commerce_Blue.jpg");
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMDocument.addCP(
			dmDocumentFile = "Document_1.doc",
			dmDocumentTitle = "DM Document Title");

		DMDocument.deleteCP(dmDocumentTitle = "Commerce_Blue.jpg");

		MyDmTest.checkElementPresent(entryTitle = "DM Document Title");

		MyDmTest.checkElementNotPresent(entryTitle = "Commerce_Blue.jpg");
	}

    @description = "Can Download a Documents and Media"
    @priority = "5"
    test CanDownloadDM {
		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMDocument.downloadCP(
			dmDocumentTitle = "DM Document Title",
            dmDocumentSize = "22 KB");
    }

}