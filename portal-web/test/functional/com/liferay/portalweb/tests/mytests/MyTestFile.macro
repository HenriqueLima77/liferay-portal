definition {

	macro checkScreenSizeValue {
		var key_valueScreenSize = "${valueScreenSize}";

		if ("${key_valueScreenSize}" == "Height") {
			AssertTextEquals.assertValue(
				locator1 = "MyTestFile#TYPE_HEIGHT_AND_WIDTH",
				value1 = "1920");
		}

		if ("${valueScreenSize}" == "Width") {
			AssertTextEquals.assertValue(
				locator1 = "MyTestFile#TYPE_HEIGHT_AND_WIDTH",
				value1 = "1080");
		}
	}

	macro OpenControlPanel {
		WaitForElementPresent(locator1 = "MyTestFile#MENU_OPEN");

		Click(locator1 = "MyTestFile#CONTROL_PANEL");

		AssertVisible(locator1 = "MyTestFile#CONFIGURATION_VISIBLE");
	}

	macro OpenPortalMenu {
		Click(locator1 = "MyTestFile#PORTAL_MENU");
	}

	macro OpenSimulation {
		Click(locator1 = "MyTestFile#SIMULATION_BTN");
	}

	macro TypePXHeightAndWidth {
		var key_valueScreenSize = "${valueScreenSize}";

		Click(locator1 = "MyTestFile#CUSTOM_BTN");

		Type(
			locator1 = "MyTestFile#TYPE_HEIGHT_AND_WIDTH",
			value1 = "${pxScreenSize}");
	}

	macro viewFormEntryWorkflowStatus {
		var key_language = "${language}";
		var key_name = "${name}";

		AssertTextEquals(
			locator1 = "MyTestFile#FORM_ENTRY_STATUS",
			value1 = "${name}");
	}

}