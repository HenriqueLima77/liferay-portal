definition {

	macro OpenControlPanel {
		WaitForElementPresent(locator1 = "MyTestFile#MENU_OPEN");

		Click(locator1 = "MyTestFile#CONTROL_PANEL");

		AssertVisible(locator1 = "MyTestFile#CONFIGURATION_VISIBLE");
	}

	macro OpenPortalMenu {
		Click(locator1 = "MyTestFile#PORTAL_MENU");
	}

	macro OpenSimulation {
		Click(locator1 = "MyTestFile#SIMULATION_BTN");
	}

	macro TypePXHeightAndWidth {
		Click(locator1 = "MyTestFile#CUSTOM_BTN");

		Type(
			locator1 = "MyTestFile#TYPE_HEIGHT",
			value1 = "1920");

		Type(
			locator1 = "MyTestFile#TYPE_WIDTH",
			value1 = "1080");
	}

}