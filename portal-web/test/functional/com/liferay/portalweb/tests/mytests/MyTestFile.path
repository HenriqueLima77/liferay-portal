<html>
<head>
<title>MyTestFile</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyTestFile</td></tr>
</thead>

<tbody>
<tr>
	<td>CONFIGURATION_VISIBLE</td>
	<td>//div[contains(@class,'applications-menu')]//h2[@class='applications-menu-nav-header'][contains(text(),'Configuration')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTROL_PANEL</td>
	<td>//button[contains(@class,'nav-link')]//span[contains(text(),'Control Panel')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_BTN</td>
	<td>//div[contains(@id,'simulation')]//span[contains(text(),'Custom')]</td>
	<td></td>
</tr>
<tr>
	<td>FORM_ENTRY_STATUS</td>
	<td>//tbody//tr[@data-qa-id='row']//td[@class=' lfr-language-column']//div[@class='search-container-column-language']//*[contains(@class,'h4 lexicon-icon lexicon-icon-${key_language}')]//ancestor::td//following-sibling::td//span[contains(text(),'${key_name}')]</td>
	<td></td>
</tr>
<tr>
	<td>MENU_OPEN</td>
	<td>//div[@class='applications-menu-wrapper']</td>
	<td></td>
</tr>
<tr>
	<td>PORTAL_MENU</td>
	<td>//ul[contains(@class,'control-menu-nav')]/li/button[contains(@data-qa-id,'applicationsMenu')]</td>
	<td></td>
</tr>
<tr>
	<td>SIMULATION_BTN</td>
	<td>//button[contains(@id,'SimulationPortlet')]</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_HEIGHT_AND_WIDTH</td>
	<td>//div[contains(@class,'custom-devices')]//*[contains(text(),'${key_valueScreenSize}')]//ancestor::div/input</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>